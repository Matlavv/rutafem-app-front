{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/styles/*": [
        "./styles/*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/datas/*": [
        "./datas/*"
      ],
      "@/images": [
        "./assets/images/index"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}